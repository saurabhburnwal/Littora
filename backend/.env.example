PORT=4000
AI_SERVICE_URL=http://localhost:8000
# Maximum time to wait for an inference response. Increase for cold starts when needed.
AI_SERVICE_TIMEOUT_MS=120000
# Comma-separated browser origins allowed to call this API in production.
# Leave unset for local development only.
FRONTEND_ORIGINS=http://localhost:5173

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
# Optional alias (code accepts either):
# SUPABASE_SECRET_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=beach-waste-images
ADMIN_EMAIL=admin@littora.app
